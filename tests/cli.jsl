  suite.it('prints a codec check, with where a file that changed first differs', function()
    local result: commands.TestCodecResult = {
      command = 'testCodec',
      results = {
        { path = 'Morrowind.esm', ok = true },
        {
          path = 'Changed.esp',
          ok = false,
