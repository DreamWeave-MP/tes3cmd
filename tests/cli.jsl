            },
          },
        },
        { type = 'MISC', id = 'Misc_SoulGem_Common', rawChanged = true, fields = {} },
      },
    }

    expect(cli.render(diffed)).toBe(table.concat({
      'left_only: []',
      'right_only: []',
      'changed:',
      '- type: STAT',
      '  id: bt_balmora_bench',
